rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection: users can read, create, and update their own profile document
    match /users/{userId} {
      allow read, create, update: if isOwner(userId);
      allow delete: if false; // User profiles cannot be client-deleted
    }

    // Transactions collection: users can read their own transactions, client cannot write
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false; // Only Webhook / Admin SDK can write
    }

    // Tracking collection: client cannot write directly
    match /tracking/{trackingId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false; // Only Cloud Function / Admin SDK can write
    }

    // Withdrawals collection: users can read their own withdrawals, client cannot write directly
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false; // Only Cloud Function / Admin SDK can write
    }
  }
}
