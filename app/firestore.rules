rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Users collection: users can read, create, and update their own profile document (balance tampering strictly blocked)
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) 
        && (!request.resource.data.keys().hasAny(['balanceAvailable', 'balancePending']) 
            || (request.resource.data.balanceAvailable == 0 && request.resource.data.balancePending == 0));
      allow update: if isOwner(userId) 
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['balanceAvailable', 'balancePending']));
      allow delete: if false;
    }

    // Withdrawals collection: users can read their own withdrawals, ZERO client write permission (server-authoritative)
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false;
    }

    // Legacy withdrawalRequests subcollection: read-only for owner, zero client writes
    match /users/{userId}/withdrawalRequests/{requestId} {
      allow read: if isOwner(userId);
      allow create, update, delete: if false;
    }

    // Transactions collection: users can read their own transactions, client cannot write
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false; // Only Webhook / Admin SDK can write
    }

    // Tracking collection: client cannot write directly
    match /tracking/{trackingId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create, update, delete: if false; // Only Cloud Function / Admin SDK can write
    }
  }
}
